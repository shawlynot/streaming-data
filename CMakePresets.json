{
  "version": 3,
  "configurePresets": [
    {
      "name": "clang",
      "displayName": "Clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang",
      "configurePreset": "clang"
    }
  ],
  "testPresets": [
    {
      "name": "clang",
      "configurePreset": "clang"
    }
  ]
}
